{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "top_up",
        "adjustment",
        "debit"
      ],
      "default": "top_up"
    },
    "amount": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}