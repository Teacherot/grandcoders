{
  "name": "Reconcile Wallets",
  "description": "Recomputes every agent wallet balance from transaction history daily and corrects any drift from bulk-debit race conditions to prevent platform loss",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 1 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reconcile_wallets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reconcile": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcileWallets"
          },
          "then": "end",
          "x-base44": {
            "title": "Reconcile agent wallets",
            "description": "Fix balance drift across all agents"
          }
        }
      }
    ]
  }
}