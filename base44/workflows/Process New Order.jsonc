{
  "name": "Process New Order",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_new_order",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "wait_for_push": {
          "wait": "PT30S",
          "then": "notify",
          "x-base44": {
            "title": "Wait for supplier push",
            "description": "Let the existing push finish"
          }
        }
      },
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAgentOrder",
            "args": {
              "order_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Mark Processing + notify agent",
            "description": "Update status, email agent"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "description": "When a new order is created, waits briefly for the existing supplier push to finish, then marks any still-pending order as Processing and emails the assigned agent. Does not push to the supplier itself."
}