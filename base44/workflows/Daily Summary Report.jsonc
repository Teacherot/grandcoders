{
  "name": "Daily Summary Report",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_summary_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailySummaryReport"
          },
          "then": "end",
          "x-base44": {
            "title": "Send daily report",
            "description": "Email admins order & commission summary"
          }
        }
      }
    ]
  },
  "description": "Emails admins a daily summary of yesterday's successful orders and per-agent commission totals every morning at 9am.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}