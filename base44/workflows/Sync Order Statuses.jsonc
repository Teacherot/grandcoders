{
  "name": "Sync Order Statuses",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_order_statuses",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncOrderStatuses",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync order statuses from supplier",
            "description": "Polls GMPL for delivery status of processing orders"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Polls the GMPL supplier every 5 minutes for the delivery status of processing orders (webhook fallback) and marks them completed/failed."
}